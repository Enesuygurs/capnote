{
  "name": "capnote",
  "version": "1.0.0",
  "description": "Capnote - a modern desktop notes and journal app",
  "main": "src/main/index.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,html,css,json}\""
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Enesuygurs/capnote.git"
  },
  "keywords": [
    "electron",
    "capnote",
    "notes",
    "journal",
    "diary",
    "markdown"
  ],
  "author": "Valkyr",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "electron": "^45.0.0",
    "electron-builder": "^26.18.0",
    "electron-reloader": "^1.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1"
  },
  "build": {
    "appId": "com.valkyr.capnote",
    "productName": "Capnote",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icons/capnote.ico"
    },
    "mac": {
      "target": "dmg",
      "icon": "assets/icons/capnote-512.png"
    },
    "linux": {
      "target": "AppImage",
      "icon": "assets/icons/capnote-512.png"
    }
  }
}
