{
  "name": "capnote",
  "version": "1.0.0",
  "description": "Capnote — modern masaüstü not ve günlük uygulaması",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "build-win": "electron-builder --win",
    "build-mac": "electron-builder --mac",
    "build-linux": "electron-builder --linux",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write \"src/**/*.{js,html,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,html,css,json}\""
  },
  "keywords": [
    "electron",
    "capnote",
    "voice",
    "speech-to-text",
    "notes"
  ],
  "author": "Valkyr",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.37.0",
    "electron": "^28.0.0",
    "electron-builder": "^24.6.4",
    "electron-reloader": "^1.2.0",
    "eslint": "^9.37.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.6.2"
  },
  "dependencies": {
    "@fontsource/crimson-text": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/roboto-mono": "^5.3.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "dompurify": "^3.4.17",
    "electron-store": "^8.1.0",
    "marked": "^18.1.1"
  },
  "build": {
    "appId": "com.valkyr.capnote",
    "productName": "Capnote",
    "directories": {
      "output": "dist"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
